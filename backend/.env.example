# Server
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# Auth
SESSION_SECRET=replace-with-a-long-random-string

# Database
MONGODB_URI=mongodb://localhost:27017/prepkit

# LLM provider (see backend/src/llm/client.ts)
LLM_PROVIDER=groq
GROQ_API_KEY=
# Fallback provider, only needed if you switch LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Public-discussion search (Tavily)
TAVILY_API_KEY=
